# GSMLite environment. Copy to .env (server: deploy/.env) and fill in. Never commit the filled file.
# Full checklist with where to get each value: docs/CREDENTIALS.md

# ── Required ───────────────────────────────────────────────────────────────
# Server (docker compose): only POSTGRES_PASSWORD and SITE_DOMAIN; the app's DATABASE_URL is built from them.
POSTGRES_PASSWORD=""            # long random string: openssl rand -hex 24
SITE_DOMAIN=""                  # gsmlite.com (Caddy gets the HTTPS certificate for it)
# Vercel / other hosts: the database URLs (pooled + direct).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

NEXT_PUBLIC_SITE_URL=""         # https://gsmlite.com
BETTER_AUTH_SECRET=""           # openssl rand -base64 32
ENCRYPTION_KEY=""               # openssl rand -base64 32  (encrypts codes, supplier keys, KYC files, passwords in orders) — back it up!
CRON_SECRET=""                  # openssl rand -hex 24  (scheduled jobs; also the code for the first-run page /admin/setup)

# ── Payments ───────────────────────────────────────────────────────────────
MONCASH_MODE="live"             # sandbox | live
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""            # card payments (Stripe Checkout)
STRIPE_WEBHOOK_SECRET=""        # webhook https://<site>/api/payments/card/webhook, event checkout.session.completed

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM=""                   # "GSMLite <no-reply@gsmlite.com>"

# ── Sign-in with Google + Search Console (same Google OAuth client) ───────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Telegram (channel posts, staff alerts, customer notifications) ────────
TELEGRAM_BOT_TOKEN=""

# ── Content machine ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""            # AI writer
DATAFORSEO_LOGIN=""             # keyword research
DATAFORSEO_PASSWORD=""
DATAFORSEO_SANDBOX=""           # "1" = free test data while trying it out

# ── Push notifications (web push) ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="" # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""                # mailto:support@gsmlite.com

# ── Bot check (Cloudflare Turnstile, free) ─────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Files ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=""                   # server: set by the Docker image (/data/uploads). Vercel: leave empty and connect Blob:
BLOB_READ_WRITE_TOKEN=""
IMAGE_HOST=""                   # extra image host allowed by the security policy (only if images live elsewhere)

# ── Monitoring ─────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Rarely needed ──────────────────────────────────────────────────────────
TRUSTED_ORIGINS=""              # extra addresses allowed to sign in, comma-separated
ADMIN_IP_ALLOWLIST_OFF=""       # "1" only if you locked yourself out with the admin IP allowlist
PASSWORD_BREACH_CHECK=""        # "off" disables the leaked-password check (not recommended)
ALLOW_MOCK_PAYMENTS=""          # "1" = test card payments without Stripe on a production build (never on the live site)
