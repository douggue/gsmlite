# Database. Adding Neon from Vercel → Storage sets both automatically:
# DATABASE_URL = pooled connection ("-pooler" host), DATABASE_URL_UNPOOLED = direct connection (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/haiti_gaming"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/haiti_gaming"

# Auth (generate with: openssl rand -base64 32). BETTER_AUTH_URL is optional on Vercel (taken from the request).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Encryption key for gift-card codes and provider secrets (32 bytes, base64)
ENCRYPTION_KEY=""

# Public site URL (SEO, links in emails, payment return URLs). Optional on Vercel: without it the project's
# production address (https://<project>.vercel.app) is used. Set it once you connect your own domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# MonCash (leave empty to run MonCash in mock mode for development)
MONCASH_MODE="sandbox"          # sandbox | live
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""

# Private file storage for NatCash payment screenshots: a Vercel Blob store with private access.
# Connecting the Blob store to the Vercel project sets this automatically. Without it, screenshots are
# skipped in production (the reference number still works).
BLOB_READ_WRITE_TOKEN=""

# Email (Resend). Leave empty until your domain is verified in Resend: until then "forgot password"
# goes through WhatsApp support and staff create a one-time reset link in Admin → Customers.
# Testing tip: EMAIL_FROM="Haiti Gaming <onboarding@resend.dev>" works only for sending to your own Resend login email.
RESEND_API_KEY=""
EMAIL_FROM=""                  # e.g. "Haiti Gaming <no-reply@yourdomain.com>"

# Extra origins allowed to sign in (comma-separated). Vercel preview URLs are trusted automatically.
TRUSTED_ORIGINS=""

# Cron secret for /api/cron/* (MonCash status polling, holds, auto-refunds). Vercel Cron sends it automatically.
# It is also the code asked for on the one-time first-run page /admin/setup.
CRON_SECRET=""

# Bot check on sign-up, sign-in, forgot password, deposit and newsletter (Cloudflare Turnstile, free).
# Leave both empty to keep it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Error monitoring (Sentry). Paste the project's DSN to turn it on; empty = off.
SENTRY_DSN=""
