generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations; on Neon/Supabase use the pooled URL above for the app.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────── Auth (Better Auth) ───────────────────────────────

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_MANAGER
  FINANCE_MANAGER
  CONTENT_EDITOR
  SUPPORT_AGENT
  FULFILLMENT
  /// Permissions come from customRole
  CUSTOM
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum Currency {
  HTG
  USD
}

model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  phone            String?
  role             Role          @default(CUSTOMER)
  status           AccountStatus @default(ACTIVE)
  locale           String        @default("ht")
  /// Country on the account (ISO code), set from the visitor's location at sign-up; decides services and payment methods
  country          String?
  displayCurrency  Currency      @default(HTG)
  twoFactorEnabled Boolean?      @default(false)
  customRoleId     String?
  customRole       CustomRole?   @relation(fields: [customRoleId], references: [id])
  referralCode     String?       @unique
  /// { email: boolean, whatsapp: boolean, marketing: boolean }
  notifyPrefs      Json          @default("{\"email\":true,\"whatsapp\":true,\"marketing\":false}")
  /// Cart saved to the account so it follows the customer across devices
  savedCart        Json          @default("[]")
  /// City picked by the customer (shown next to their first name on reviews)
  city             String?
  /// Kept from the original codebase; no longer shown anywhere
  showInFeed       Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  orders         Order[]
  ledgerAccounts LedgerAccount[]
  paymentIntents PaymentIntent[]    @relation("PaymentCustomer")
  reviewed       PaymentIntent[]    @relation("PaymentReviewer")
  quotes         ExchangeQuote[]
  notifications  Notification[]
  pushSubs       PushSubscription[]
  savedPlayerIds SavedPlayerId[]
  riskFlags      RiskFlag[]
  auditEvents    AuditEvent[]
  tickets        SupportTicket[]    @relation("TicketCustomer")
  ticketMessages SupportMessage[]
  referralsMade  Referral[]         @relation("Referrer")
  referredBy     Referral?          @relation("Referred")
  reviews        Review[]
  priceGroupId   String?
  priceGroup     PriceGroup?        @relation(fields: [priceGroupId], references: [id])

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─────────────────────────────── Catalog ───────────────────────────────

/// Localized text is stored as JSON: { "ht": "...", "fr": "...", "en": "...", "es": "..." }
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        Json
  description Json?
  icon        String?
  /// Small square picture in the white tile (replaces the emoji icon)
  image       String?
  /// Big background picture filling the category card
  cover       String?
  sortOrder   Int        @default(0)
  isVisible   Boolean    @default(true)
  /// Shown in the category menu row (desktop) and the home tiles
  inMenu      Boolean    @default(true)
  /// "Hot" badge in the menu
  isHot       Boolean    @default(false)
  /// A repair tool (UnlockTool, Chimera…): listed under "Shop by tool" and "Top tools"
  isTool      Boolean    @default(false)
  /// Two-letter badge (e.g. "UT"); empty = from the name
  code        String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum FulfillmentType {
  /// License keys / codes from the encrypted stock (Admin → Code inventory)
  CODE_INVENTORY
  /// Done by staff, result typed in by hand
  MANUAL
  /// Sent to the supplier set on each option (Dhru Fusion API) and tracked automatically
  SUPPLIER_API
}

/// Dhru Fusion service kinds. IMEI: one device per order (IMEI or serial). SERVER: account-based, ordered in
/// quantities (tool credits, activations). REMOTE: done on the customer's computer through a remote session.
enum ServiceType {
  IMEI
  SERVER
  REMOTE
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  name             Json
  description      Json
  deliveryEstimate Json?
  image            String?
  /// Additional product photos (URLs), shown as a gallery on the product page
  gallery          Json             @default("[]")
  accent           String?
  isPublished      Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  fulfillmentType  FulfillmentType  @default(MANUAL)
  /// Array of custom field definitions: [{ key, label: {ht,fr,en,es}, type, required, placeholder? }]
  fields           Json             @default("[]")
  seoTitle         Json?
  seoDescription   Json?
  sortOrder        Int              @default(0)
  /// Filter tags such as platform:android, region:us (shown as store filters)
  tags             String[]         @default([])
  serviceType      ServiceType      @default(IMEI)
  /// IMEI services: label of the identifier box ("IMEI", "Serial number", "IMEI or SN")
  identifierLabel  Json?
  /// "imei" (15 digits + check digit), "serial" (letters and digits) or "any"
  identifierFormat String           @default("imei")
  /// Several identifiers in one order, one per line (each becomes its own order line)
  allowBulk        Boolean          @default(true)
  /// Where it is sold: "all" (worldwide), "only" (just `countries`) or "except" (everywhere but `countries`). ISO codes.
  countryMode      String           @default("all")
  countries        String[]         @default([])
  /// FRP, iCloud, MDM…: no Google page, noindex, kept out of the sitemap, hubs and public price list; signed-in customers only
  hideFromGoogle   Boolean          @default(false)
  /// Card art: short title (2 lines), ribbon text, and color ("ink", "green", "mint", "slate"). Empty = from name and delivery time.
  cardTitle        Json?
  cardTag          Json?
  cardStyle        String           @default("ink")
  variants         ProductVariant[]
  reviews          Review[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, isPublished])
}

model ProductVariant {
  id                String       @id @default(cuid())
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              Json
  /// Price in USD cents (integer minor units). HTG prices are converted at the store rate.
  priceUsd          Int
  salePriceUsd      Int?
  sortOrder         Int          @default(0)
  isActive          Boolean      @default(true)
  /// Marked "out of stock" by staff: stays visible (red dot, struck through) but can't be bought
  soldOut           Boolean      @default(false)
  /// "Stock is low" message: off | auto (codes left under the limit) | on (manual, until lowStockUntil)
  lowStock          String       @default("off")
  lowStockUntil     DateTime?
  sku               String?      @unique
  /// SERVER services: allowed quantity (credits); IMEI services keep 1–1
  minQty            Int          @default(1)
  maxQty            Int          @default(1)
  /// Supplier this option is sent to when the product is SUPPLIER_API
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  /// SERVICEID on the supplier's side
  supplierServiceId String?
  /// What the supplier charges us per unit, in USD cents (refreshed by catalog sync)
  costUsd           Int?
  /// Set out of stock by a sync because the supplier stopped offering the service; undone if it comes back
  pausedBySupplier  Boolean      @default(false)
  codes             CodeItem[]
  orderItems        OrderItem[]
  groupPrices       GroupPrice[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum CodeStatus {
  AVAILABLE
  ASSIGNED
  VOID
}

model CodeItem {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  codeEncrypted String
  /// HMAC of the code; prevents importing the same code twice
  codeHash      String         @unique
  batchLabel    String?
  costHtg       Int?
  status        CodeStatus     @default(AVAILABLE)
  orderItemId   String?
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id])
  createdAt     DateTime       @default(now())
  assignedAt    DateTime?

  @@index([variantId, status])
  @@index([orderItemId])
}

model SavedPlayerId {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  label     String?
  values    Json
  createdAt DateTime @default(now())

  @@index([userId, productId])
}

// ─────────────────────────────── Orders ───────────────────────────────

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  FULFILLED
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentMethodKind {
  WALLET
  MONCASH
  NATCASH
  MANUAL
  /// Visa/Mastercard through Stripe Checkout (USD)
  CARD
}

model Order {
  id             String            @id @default(cuid())
  number         Int               @unique @default(autoincrement())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  status         OrderStatus       @default(AWAITING_PAYMENT)
  currency       Currency
  /// Totals in minor units of `currency`
  subtotal       Int
  total          Int
  /// HTG per 1 USD at the time of the order, when charged in USD
  rateUsed       Decimal?          @db.Decimal(18, 8)
  paymentMethod  PaymentMethodKind
  manualMethodId String?
  recipientNote  String?
  accessToken    String            @unique
  /// WEB (site) or API (reseller API)
  source         String            @default("WEB")
  items          OrderItem[]
  events         OrderEvent[]
  payments       PaymentIntent[]
  review         Review?
  riskFlags      RiskFlag[]
  paidAt         DateTime?
  fulfilledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum ItemStatus {
  PENDING
  DELIVERED
  /// Rejected (by staff or the supplier) and refunded to the wallet
  FAILED
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  productName    Json
  variantName    Json
  quantity       Int
  unitPrice      Int
  fieldValues    Json            @default("{}")
  /// IMEI / serial for IMEI services (also inside fieldValues), indexed for lookups
  identifier     String?
  status         ItemStatus      @default(PENDING)
  /// Result shown to the customer: unlock code, check report, rejection reason (from staff or the supplier)
  deliveryNote   String?
  refundedAt     DateTime?
  /// When the line got its result or was refunded (real delivery time and success rate per service)
  finishedAt     DateTime?
  codes          CodeItem[]
  supplierOrders SupplierOrder[]

  @@index([identifier])
  @@index([variantId, finishedAt])
}

/// Append-only order history
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ─────────────────────────────── Payments ───────────────────────────────

enum PaymentProvider {
  MONCASH
  NATCASH
  /// Other manual methods configured in Admin → Payment methods (bank transfer, other wallets…)
  MANUAL
  /// Stripe Checkout; providerRef = Checkout Session id
  CARD
}

enum PaymentStatus {
  PENDING
  REVIEW
  SUCCEEDED
  FAILED
  REJECTED
  EXPIRED
}

/// External money coming in. Every successful intent credits the customer's wallet;
/// when linked to an order, the order is then paid from the wallet in the same transaction.
model PaymentIntent {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("PaymentCustomer", fields: [userId], references: [id])
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id])
  provider       PaymentProvider
  manualMethodId String?
  manualMethod   ManualMethod?   @relation(fields: [manualMethodId], references: [id])
  amount         Int
  currency       Currency        @default(HTG)
  status         PaymentStatus   @default(PENDING)
  /// Provider transaction id (MonCash) or customer-submitted reference (NatCash); unique per provider
  providerRef    String?
  payerPhone     String?
  evidencePath   String?
  reviewedById   String?
  reviewedBy     User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewNote     String?
  holdUntil      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  riskFlags      RiskFlag[]

  @@unique([provider, providerRef])
  @@index([status, provider])
  @@index([userId, createdAt])
}

// ─────────────────────────────── Ledger ───────────────────────────────

enum LedgerAccountType {
  CUSTOMER_WALLET
  CUSTOMER_HELD
  CLEARING
  REVENUE
  FX
  ADJUSTMENT
}

model LedgerAccount {
  id            String            @id @default(cuid())
  code          String            @unique
  type          LedgerAccountType
  currency      Currency
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  /// Cached balance in minor units; kept in sync inside every posting transaction
  balance       Int               @default(0)
  allowNegative Boolean           @default(false)
  entries       LedgerEntry[]
  createdAt     DateTime          @default(now())

  @@index([userId])
}

enum LedgerTxType {
  DEPOSIT
  PURCHASE
  REFUND
  EXCHANGE
  ADJUSTMENT
  HOLD_RELEASE
  /// Marketing credit: top-up bonus, referral reward, promotions
  BONUS
}

model LedgerTransaction {
  id             String        @id @default(cuid())
  type           LedgerTxType
  idempotencyKey String        @unique
  description    String
  createdById    String?
  metadata       Json          @default("{}")
  entries        LedgerEntry[]
  createdAt      DateTime      @default(now())
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  currency      Currency
  /// Signed amount in minor units. Entries of one transaction sum to zero per currency.
  amount        Int
  createdAt     DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
}

model ExchangeQuote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fromCurrency Currency
  toCurrency   Currency
  fromAmount   Int
  toAmount     Int
  rate         Decimal   @db.Decimal(18, 8)
  feeAmount    Int
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// ─────────────────────────────── Risk, audit, settings, notifications ───────────────────────────────

enum RiskStatus {
  OPEN
  APPROVED
  REJECTED
}

model RiskFlag {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id])
  reason          String
  status          RiskStatus     @default(OPEN)
  resolvedById    String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?

  @@index([status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A browser/phone that accepted push notifications (Web Push). Removed when the push service says it's gone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Message key in the `notifications` namespace, rendered in the reader's language
  type      String
  params    Json      @default("{}")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────── Staff roles & sensitive actions ───────────────────────────────

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Recent re-authentication (TOTP) for a session, required before high-risk admin actions.
model StepUp {
  sessionToken String   @id
  userId       String
  until        DateTime
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Large wallet adjustments need a second staff member to approve (two-person rule).
model PendingApproval {
  id          String         @id @default(cuid())
  kind        String
  payload     Json
  summary     String
  requestedBy String
  decidedBy   String?
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  @@index([status])
}

// ─────────────────────────────── Support ───────────────────────────────

enum TicketStatus {
  OPEN
  WAITING_CUSTOMER
  CLOSED
}

model SupportTicket {
  id         String           @id @default(cuid())
  number     Int              @unique @default(autoincrement())
  userId     String
  user       User             @relation("TicketCustomer", fields: [userId], references: [id])
  orderId    String?
  subject    String
  status     TicketStatus     @default(OPEN)
  assignedTo String?
  messages   SupportMessage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id             String        @id @default(cuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  fromStaff      Boolean       @default(false)
  body           String
  attachmentPath String?
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────────────────────── Referrals ───────────────────────────────

enum ReferralStatus {
  PENDING
  REWARDED
  REJECTED
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id])
  referredId   String         @unique
  referred     User           @relation("Referred", fields: [referredId], references: [id])
  status       ReferralStatus @default(PENDING)
  rewardAmount Int?
  signupIp     String?
  note         String?
  createdAt    DateTime       @default(now())
  rewardedAt   DateTime?

  @@index([referrerId])
}

// ─────────────────────────────── Content & SEO ───────────────────────────────

model NewsArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// "post" (news), "tool" (tool update: toolName + version), "feature", "security", "howto"
  kind        String    @default("post")
  toolName    String?
  version     String?
  title       Json
  excerpt     Json      @default("{}")
  body        Json      @default("{}")
  image       String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model RedirectRule {
  id        String   @id @default(cuid())
  /// Path without locale, e.g. "/old-free-fire"
  from      String   @unique
  /// Path without locale ("/products/free-fire-diamonds") or a full https URL
  to        String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Title/description overrides for fixed pages ("/", "/store", "/guides", …)
model PageSeo {
  path        String   @id
  title       Json     @default("{}")
  description Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

/// Admin overrides of interface wording (message catalog keys like "home.heroTitle")
model TranslationOverride {
  locale    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([locale, key])
}

// ─────────────────────────────── Final additions ───────────────────────────────

/// Manual payment methods beyond NatCash, set up by staff (e.g. bank transfer, another mobile wallet).
model ManualMethod {
  id              String          @id @default(cuid())
  code            String          @unique
  name            Json
  instructions    Json            @default("{}")
  recipientName   String
  recipientNumber String
  logo            String?
  /// "mobile" (NatCash-like wallet, bank…) or "crypto" (recipientNumber holds the address)
  kind            String          @default("mobile")
  /// Crypto only: network shown to customers, e.g. "BEP-20 (BSC)"
  network         String?
  /// Optional QR image customers can scan (crypto addresses get a generated QR when empty)
  qrImage         String?
  /// Wallet credited by deposits: HTG for mobile money, USD for USDT
  currency        Currency        @default(HTG)
  isEnabled       Boolean         @default(true)
  /// Countries that see this method: "all", "only" or "except" + ISO codes. Nobody else sees anything about it.
  countryMode     String          @default("all")
  countries       String[]        @default([])
  allowDeposits   Boolean         @default(true)
  allowOrders     Boolean         @default(true)
  sortOrder       Int             @default(0)
  payments        PaymentIntent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// Browser seen at sign-in (long-lived anonymous cookie) for multi-account detection.
model DeviceSeen {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  ip        String?
  userAgent String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([ip])
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String   @unique
  folder     String
  uploadedBy String?
  alt        String?
  createdAt  DateTime @default(now())

  @@index([folder, createdAt])
}

/// Custom content pages built from blocks (text, image, button, FAQ)
model Page {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        Json
  description  Json     @default("{}")
  blocks       Json     @default("[]")
  isPublished  Boolean  @default(false)
  showInFooter Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("ht")
  token          String    @unique
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

/// Customer review: asked after delivery (source "order") or typed in by staff from a real comment (source "admin").
model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  rating    Int
  quote     String
  /// "Jean-Philippe M."
  name      String
  city      String?
  locale    String   @default("ht")
  source    String   @default("order")
  /// pending | approved | hidden
  status    String   @default("pending")
  /// Shown in the homepage reviews section
  onHome    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([status, onHome])
}

// ─────────────────────────────── Suppliers (Dhru Fusion API) ───────────────────────────────

model Supplier {
  id              String    @id @default(cuid())
  name            String
  /// Site address, e.g. https://supplier.example.com (the API is at /api/index.php)
  baseUrl         String
  username        String
  /// API access key, AES-256-GCM encrypted with ENCRYPTION_KEY; never shown again after saving
  apiKeyEncrypted String
  /// How `parameters` is sent: "xml" (classic Dhru kit, widest support) or "json" (base64 JSON)
  paramFormat     String    @default("xml")
  isEnabled       Boolean   @default(true)
  /// Last balance reported by accountinfo (supplier currency, cents)
  balance         Int?
  currency        String?
  /// Alert when the balance drops under this (cents, 0 = off)
  lowBalanceAlert Int       @default(0)
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  services SupplierService[]
  variants ProductVariant[]
  orders   SupplierOrder[]
  logs     SupplierLog[]
}

/// The supplier's catalog as last synced (imeiservicelist). Staff link options to these.
model SupplierService {
  id             String      @id @default(cuid())
  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  remoteId       String
  groupName      String
  name           String
  type           ServiceType
  /// Supplier price per unit in cents of the supplier currency
  credit         Int
  time           String?
  info           String?
  /// Inputs the order needs: [{ name, type, required, options }], identifier label, qty rules
  fields         Json        @default("[]")
  /// Seen in the last sync; false = gone from the supplier's list
  active         Boolean     @default(true)
  /// Cost before the last price change, and when it changed (shown as "↑ was $x" in the service list)
  previousCredit Int?
  priceChangedAt DateTime?
  /// First sync that listed it ("New" filter)
  firstSeenAt    DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([supplierId, remoteId])
  @@index([supplierId, groupName])
}

enum SupplierOrderStatus {
  /// Being sent right now (if this sticks, the send's outcome is unknown)
  SUBMITTING
  /// Accepted by the supplier (Dhru STATUS 0 New)
  WAITING
  /// Dhru STATUS 1 In process
  IN_PROCESS
  /// Dhru STATUS 4: result in `result`
  SUCCESS
  /// Dhru STATUS 3, or refused when placing: refunded
  REJECTED
  /// No clear answer when placing (timeout, broken reply). Never re-sent automatically: staff check with the supplier.
  UNKNOWN
}

/// One attempt to have the supplier process an order line.
model SupplierOrder {
  id          String              @id @default(cuid())
  orderItemId String
  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  serviceId   String
  /// REFERENCEID returned by placeimeiorder
  remoteRef   String?
  status      SupplierOrderStatus @default(SUBMITTING)
  result      String?
  /// What the supplier said when it refused or failed (staff only)
  error       String?
  checks      Int                 @default(0)
  nextCheckAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextCheckAt])
  @@index([orderItemId])
}

/// Requests to suppliers, secrets removed, for troubleshooting (kept 30 days).
model SupplierLog {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  action     String
  request    String
  response   String?
  httpStatus Int?
  ms         Int
  ok         Boolean
  createdAt  DateTime @default(now())

  @@index([supplierId, createdAt])
}

// ─────────────────────────────── Price groups ───────────────────────────────

/// Customer groups with their own prices (e.g. Retail, Repair shop, Gold shop).
model PriceGroup {
  id          String       @id @default(cuid())
  name        String       @unique
  /// Discount off the list price in basis points (500 = 5 %)
  discountBps Int          @default(0)
  users       User[]
  prices      GroupPrice[]
  createdAt   DateTime     @default(now())
}

/// A fixed price for one option in one group (wins over the group discount).
model GroupPrice {
  priceGroupId String
  priceGroup   PriceGroup     @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceUsd     Int

  @@id([priceGroupId, variantId])
}

/// Home page offer slider (admin → Homepage). Shown between its dates, only in its countries.
model HomeSlide {
  id          String    @id @default(cuid())
  /// Small labels above the title, e.g. "OFFER" and "FIRST TOP-UP · OCT 1–31" (per language)
  tag         Json      @default("{}")
  label       Json      @default("{}")
  title       Json
  /// One line per bullet, per language
  bullets     Json      @default("{}")
  buttonText  Json      @default("{}")
  buttonHref  String    @default("/")
  button2Text Json      @default("{}")
  button2Href String?
  image       String?
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  countryMode String    @default("all")
  countries   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Phone model per TAC (first 8 digits of the IMEI), for the free IMEI check.
model TacModel {
  tac       String   @id
  brand     String
  model     String
  /// "import" (CSV in admin), "supplier" (free-check service) or "learned" (from a delivered check result)
  source    String
  updatedAt DateTime @updatedAt
}

/// Free IMEI checks, for the daily limit per account and device, and the customer's IMEI history.
model FreeCheck {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String?
  imei      String
  brand     String?
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

/// Deal of the week: a sale price on one option between two dates (set and removed automatically).
model Deal {
  id           String    @id @default(cuid())
  variantId    String
  /// Deal price in USD cents (written to the option's sale price while the deal runs)
  priceUsd     Int
  /// Sale price the option had before, put back at the end
  previousSale Int?
  startsAt     DateTime  @default(now())
  endsAt       DateTime
  endedAt      DateTime?
  /// Posted to the Telegram channel / customers
  announcedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([endedAt, endsAt])
}

enum ServiceChangeKind {
  NEW
  PRICE_DOWN
  PRICE_UP
  REMOVED
  BACK
}

/// Automatic "Service changes" feed on the News page (from supplier syncs, deals and admin edits).
model ServiceChange {
  id        String            @id @default(cuid())
  kind      ServiceChangeKind
  productId String
  variantId String?
  /// USD cents, for price changes
  oldPrice  Int?
  newPrice  Int?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([productId, createdAt])
}
